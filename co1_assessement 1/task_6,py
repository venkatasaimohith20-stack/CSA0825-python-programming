# Global constants
BASE_RATE = 30.0
FAT_RATE = 0.40
SNF_RATE = 0.30
DAYS = 10


def rate_per_litre(fat, snf):
    """Calculate and return the milk rate per litre."""
    rate = BASE_RATE + fat * FAT_RATE + snf * SNF_RATE
    return rate


def payout(litres, rate):
    """Calculate and return the payment for the milk delivered."""
    return litres * rate


def ten_day_total(daily_amount, days=DAYS):
    """Calculate and return the total for the given number of days."""
    return daily_amount * days


def display_receipt(farmer_id, litres, fat, snf, rate, amount, total):
    """Print the farmer's payment details."""
    print("\n--- Farmer Payment Receipt ---")
    print(f"Farmer ID:          {farmer_id}")
    print(f"Milk quantity:      {litres:.2f} litres")
    print(f"Fat percentage:     {fat:.2f}%")
    print(f"SNF percentage:     {snf:.2f}%")
    print(f"Rate per litre:     Rs. {rate:.2f}")
    print(f"Daily payment:      Rs. {amount:.2f}")
    print(f"Ten-day total:      Rs. {total:.2f}")


# Main program
farmer_id = input("Enter Farmer ID: ")
litres = float(input("Enter milk quantity in litres: "))
fat = float(input("Enter fat percentage: "))
snf = float(input("Enter SNF percentage: "))

if litres <= 0 or not (2.0 <= fat <= 7.0) or not (0 <= snf <= 100):
    print("Invalid input. Check litres, fat and SNF values.")
else:
    rate = rate_per_litre(fat, snf)
    amount = payout(litres, rate)
    total = ten_day_total(amount)

    display_receipt(
        farmer_id, litres, fat, snf, rate, amount, total
    )